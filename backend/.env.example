# ── Neon PostgreSQL ───────────────────────────────────────────────────────────
# Get this from neon.tech → your project → Connection Details → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# ── Discord OAuth ─────────────────────────────────────────────────────────────
# discord.com/developers/applications → your app → OAuth2
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
# Must match exactly what you set in Discord's OAuth2 Redirects
DISCORD_REDIRECT_URI=https://your-app.vercel.app/auth/discord/callback

# ── Cloudinary (free image hosting) ──────────────────────────────────────────
# cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app
API_URL=https://your-app.vercel.app

# ── Discord bot / server ──────────────────────────────────────────────────────
# Bot token (discord.com/developers → your app → Bot). Used for the login server-check,
# BOTM announcements, polls and the Dialed.gg posts.
DISCORD_BOT_TOKEN=
# The club's Discord server ID. Only members of this server can log in.
DISCORD_GUILD_ID=
# Public key for verifying slash-command requests (General Information → Public Key)
DISCORD_APP_PUBLIC_KEY=
# Webhooks for announcements (new books, reviews, digests) and BOTM
DISCORD_WEBHOOK_ANNOUNCEMENTS=
DISCORD_WEBHOOK_BOTM=

# ── Cron (cron-job.org) ───────────────────────────────────────────────────────
# REQUIRED for /api/digest, /api/yearend, /api/dialed-morning and /api/dialed-evening.
# If unset those endpoints refuse every request. Each cron job must send the header:
#   Authorization: Bearer <this value>
CRON_SECRET=

# ── Dialed.gg daily leaderboard ──────────────────────────────────────────────
DIALED_CHANNEL_ID=
# Optional — defaults to America/New_York
DIALED_TIMEZONE=

# ── Club timezone (optional) ──────────────────────────────────────────────────
# "Today", "this month" and "last year" for finish dates, the digest and the year-end post.
# Defaults to America/Aruba
CLUB_TIMEZONE=

# ── Book search (optional) ────────────────────────────────────────────────────
# Without this, search uses Open Library only
GOOGLE_BOOKS_API_KEY=

# ── Local dev only ────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
